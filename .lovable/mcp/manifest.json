{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rqygtziqkfywaiktmzvx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vicentino-connect",
      "version": "0.1.0",
      "title": "Vicentino Connect"
    },
    "tools": [
      {
        "name": "listar_paroquias",
        "title": "Listar paróquias e grupos",
        "description": "Lista as paróquias e grupos vicentinos ativos com seus bairros de referência.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "buscar_assistidos",
        "title": "Buscar famílias assistidas",
        "description": "Busca famílias assistidas visíveis ao usuário por nome, bairro ou status. Não retorna CPF nem observações sensíveis.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "nome": {
              "description": "Parte do nome do responsável.",
              "type": "string",
              "minLength": 1
            },
            "bairro": {
              "description": "Bairro.",
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "Ativo",
                "Em acompanhamento",
                "Suspenso",
                "Encerrado",
                "Em análise territorial"
              ]
            },
            "limite": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "historico_assistido",
        "title": "Histórico da família",
        "description": "Retorna as visitas e entregas recentes de uma família assistida.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "assistido_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID da família assistida."
            },
            "limite": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "assistido_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "registrar_visita",
        "title": "Registrar visita",
        "description": "Registra uma visita vicentina a uma família assistida, em nome do usuário conectado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "assistido_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "data_visita": {
              "description": "Data (AAAA-MM-DD). Padrão: hoje.",
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "tipo_visita": {
              "default": "Acompanhamento",
              "type": "string",
              "enum": [
                "Primeira visita",
                "Acompanhamento",
                "Entrega",
                "Espiritual",
                "Reavaliação"
              ]
            },
            "como_familia_esta": {
              "type": "string",
              "maxLength": 2000
            },
            "necessidades": {
              "default": [],
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "proxima_visita": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "assistido_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
